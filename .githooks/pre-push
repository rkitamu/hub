#!/bin/sh
# main / master への push（削除を含む）を拒否する。
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
  refs/heads/main | refs/heads/master)
    echo "pre-push: ${remote_ref#refs/heads/} への push は拒否しました。作業ブランチを push して PR を介してください" >&2
    exit 1
    ;;
  esac
done
exit 0
