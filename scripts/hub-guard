#!/usr/bin/env python3
"""Edit / Write / NotebookEdit の書き込み先を制限する PreToolUse フック。

usage:
  hub-guard --root <hub-env>               司令塔用。hub-env の外へ書くのを拒否する
  hub-guard --allow <dir> [--allow <dir>]…  lead・crew 用。どの <dir> の中でもなければ拒否する（hub-work が生成した設定が登録する）

判定は、シンボリックリンクと .. を解決した実際の書き込み先で行う。相対パスは入力の cwd から解決する。
判定できないときは拒否する（exit 2）。
Bash 経由の書き込みは対象外。
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

PATH_KEYS = {"Edit": "file_path", "Write": "file_path", "NotebookEdit": "notebook_path"}


def deny(reason: str) -> int:
    print(f"hub-guard: {reason}", file=sys.stderr)
    return 2


def own_worktree(root: Path) -> Path | None:
    """hub-work が作った hub-env の worktree で起動した作業エージェントなら、その worktree を返す。"""
    project = os.environ.get("CLAUDE_PROJECT_DIR")
    if not project or not os.path.isabs(project):
        return None
    tree = Path(project).resolve()
    if tree.name == root.name and tree.parent.parent == root.parent / ".hub-worktrees" and (tree / ".git").is_file():
        return tree
    return None


def target_of(payload: dict) -> tuple[Path | None, str | None]:
    """(実際の書き込み先, 判定できない理由)。対象外のツールなら (None, None)。"""
    tool = payload.get("tool_name")
    if tool not in PATH_KEYS:
        return None, None
    raw = (payload.get("tool_input") or {}).get(PATH_KEYS[tool])
    if not isinstance(raw, str) or not raw or "\0" in raw:
        return None, f"{tool} の書き込み先を判定できません"
    path = Path(raw)
    if not path.is_absolute():
        cwd = payload.get("cwd")
        if not isinstance(cwd, str) or not os.path.isabs(cwd):
            return None, f"相対パスの基準が分かりません: {raw}"
        path = Path(cwd) / path
    # NOTE: resolve は存在しない末尾も扱え、途中のリンクと宙づりのリンクの先まで辿る。
    return path.resolve(), None


def inside(target: Path, dirs: list[Path]) -> bool:
    return any(target == r or r in target.parents for r in dirs)


def check(root: Path, payload: dict) -> str | None:
    """--root の判定。拒否する理由を返す。許可なら None。"""
    target, error = target_of(payload)
    if target is None:
        return error
    allowed = [r for r in (root, own_worktree(root)) if r]
    if not inside(target, allowed):
        return (f"司令塔は hub-env の外を編集できません: {target}。"
                "子リポジトリの変更は、hub-work start で作業にしてください")
    return None


def check_allow(dirs: list[Path], payload: dict) -> str | None:
    """--allow の判定。拒否する理由を返す。許可なら None。"""
    target, error = target_of(payload)
    if target is None:
        return error
    if not inside(target, dirs):
        return (f"この作業で書けるのは {', '.join(map(str, dirs))} の中だけです: {target}。"
                "lead はリポジトリの変更を crew に振り、crew はほかのリポジトリの変更を lead に伝えてください")
    return None


def main() -> int:
    try:
        args = sys.argv[1:]
        usage = "usage: hub-guard --root <hub-env の絶対パス> | --allow <絶対パス> [--allow <絶対パス>]…"
        pairs = list(zip(args[::2], args[1::2]))
        if not args or len(args) % 2 or not all(os.path.isabs(v) for _, v in pairs):
            return deny(usage)
        flags = {k for k, _ in pairs}
        if flags == {"--root"} and len(pairs) == 1:
            root = Path(pairs[0][1]).resolve()
            if not root.is_dir():
                return deny(f"hub-env がありません: {root}")
            judge = lambda p: check(root, p)
        elif flags == {"--allow"}:
            dirs = [Path(v).resolve() for _, v in pairs]
            judge = lambda p: check_allow(dirs, p)
        else:
            return deny(usage)
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            return deny("フックの入力を読めません")
        reason = judge(payload)
        return deny(reason) if reason else 0
    except Exception as e:  # 判定に失敗したら通さない
        return deny(f"判定に失敗したので拒否します: {e}")


if __name__ == "__main__":
    sys.exit(main())
