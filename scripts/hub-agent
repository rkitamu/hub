#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""環境のエージェントとやり取りする。backend（hub.toml で選ぶ）によらず同じ書き方で使う。

usage:
  hub-agent list                       動いているエージェントと状態
  hub-agent send <名前> <依頼>          エージェントに送る
  hub-agent read <名前> [--lines <N>]   エージェントの画面を読む
  hub-agent notify <作業名と要約>        司令塔へ通知する（旧形式の作業エージェント用）
  hub-agent launch <名前> [--print]     hub.toml の [[agent]] の通りに、この端末で claude を起動する（--print は表示だけ）

commander のコマンド。lead は hub-lead、crew は hub-crew を使う（HUB_ROLE があれば list のほかは止まる）。

終了コード: 0 成功 / 1 失敗 / 3 backend が無いので送れない
"""

from __future__ import annotations

import argparse
import os
import shlex
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import hub_work as hw  # noqa: E402
from hub_backend import Backend, backend_for  # noqa: E402
from hub_config import COMMANDER, SESSION_RECORD, find_agent  # noqa: E402
from hublib import HubError, agent_argv, claude_launch_args, commander_launch, env_state_dir, find_env  # noqa: E402

NO_BACKEND = 3


def no_backend(backend: Backend) -> int:
    print(f"backend が無いので送れません（hub.toml の backend: {backend.name}）", file=sys.stderr)
    return NO_BACKEND


def cmd_list(a, backend: Backend, env: Path, cfg: dict) -> int:
    if backend.manual:
        return no_backend(backend)
    for x in sorted((x for x in backend.list_agents() if x.get("name")), key=lambda x: x["name"]):
        print(f"{x['name']}\t{x.get('status')}\t{x.get('cwd')}")
    return 0


def cmd_send(a, backend: Backend, env: Path, cfg: dict) -> int:
    if backend.manual:
        return no_backend(backend)
    result = backend.send(a.name, a.text)
    if result != "ok":
        print(f"{a.name} に届きませんでした（{result}）", file=sys.stderr)
        return 1
    return 0


def cmd_read(a, backend: Backend, env: Path, cfg: dict) -> int:
    if backend.manual:
        return no_backend(backend)
    sys.stdout.write(backend.read(a.name, a.lines))
    return 0


def cmd_notify(a, backend: Backend, env: Path, cfg: dict) -> int:
    if backend.manual:
        return no_backend(backend)
    return hw.notify(backend, COMMANDER, a.text, "status.md に書いてあれば、司令塔はそれを読みます")


def launch_argv(env: Path, cfg: dict, agent: dict) -> list[str]:
    launch = claude_launch_args(env, "commander" if agent["name"] == COMMANDER else None)
    if agent["name"] == COMMANDER and agent["kind"] == "claude":
        record = env_state_dir(env) / SESSION_RECORD
        launch = commander_launch(env, agent, agent["path"], launch, record) or launch
    return agent_argv(agent["kind"], launch, agent["args"])


def cmd_launch(a, backend: Backend, env: Path, cfg: dict) -> int:
    agent = find_agent(env, cfg, a.name)
    argv = launch_argv(env, cfg, agent)
    spec = {"name": agent["name"], "kind": agent["kind"], "cwd": str(agent["path"]), "argv": argv}
    if a.print:
        print(backend.launch_hint(spec))
        return 0
    if not agent["path"].is_dir():
        raise HubError(f"{agent['name']} の cwd がありません: {agent['path']}")
    os.chdir(agent["path"])
    cmd = [agent["kind"], *argv]
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        raise HubError(f"起動できません: {shlex.join(cmd)}: {e.strerror}")


def main() -> int:
    p = argparse.ArgumentParser(prog="hub-agent", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    s = sub.add_parser("send")
    s.add_argument("name")
    s.add_argument("text")
    r = sub.add_parser("read")
    r.add_argument("name")
    r.add_argument("--lines", type=int, default=120)
    sub.add_parser("notify").add_argument("text")
    la = sub.add_parser("launch")
    la.add_argument("name")
    la.add_argument("--print", action="store_true")
    a = p.parse_args()
    try:
        if a.cmd != "list":
            hw.require_role(None, f"hub-agent {a.cmd}")
        env, cfg = find_env()
        backend = backend_for(env, cfg)
        if a.cmd != "launch":
            backend.check()
        return {"list": cmd_list, "send": cmd_send, "read": cmd_read, "notify": cmd_notify,
                "launch": cmd_launch}[a.cmd](a, backend, env, cfg)
    except HubError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
