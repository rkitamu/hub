#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""MAP.md・hub.toml・実際のリポジトリ・エージェントのずれを検査する。何も変更しない。

usage: hub-check

ずれがあれば一覧して exit 1。エージェントは hub.toml の [[agent]]（旧形式ではペインの agent と setup の agents）と照合する。
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from hub_backend import Backend, backend_for  # noqa: E402
from hub_config import agent_defs  # noqa: E402
from hublib import HubError, find_env, is_git_repo, read_status, work_dir  # noqa: E402

PLANNED = ("未作成", "構想")


def map_table(text: str, heading: str) -> list[list[str]]:
    """見出しの下の表の行を返す。HTML コメントの中は読まない。"""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    m = re.search(rf"^## {re.escape(heading)}\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    if not m:
        return []
    rows = [[c.strip() for c in l.strip().strip("|").split("|")] for l in m.group(1).splitlines() if l.startswith("|")]
    return [r for r in rows[1:] if not all(set(c) <= {"-", ":"} for c in r)]


def name_of(cell: str) -> str:
    return cell.strip().strip("`")


def work_records(wd: Path) -> tuple[set[str], set[str]]:
    agents: set[str] = set()
    labels: set[str] = set()
    if wd.is_dir():
        for f in wd.glob("*/status.md"):
            if f.parent.name == "archive":
                continue
            try:
                meta, _ = read_status(f)
            except (OSError, HubError):
                continue
            agents.update(x["name"] for x in meta["agents"])
            labels.update({meta["workspace"], *(x["workspace"] for x in meta["agents"])})
    return agents, labels


def check(env: Path, cfg: dict, backend: Backend) -> list[str]:
    out: list[str] = []
    map_path = env / "hub-env/MAP.md"
    if not map_path.is_file():
        return [f"MAP.md がありません: {map_path}"]
    text = map_path.read_text()
    try:
        defs = agent_defs(env, cfg)
    except HubError as e:
        return [f"hub.toml: {e}"]

    # リポジトリ
    repos = {name_of(r[0]): r[1] if len(r) > 1 else "" for r in map_table(text, "リポジトリ") if r}
    toml_dirs = {d.name: d for d in backend.layout_dirs()}
    for a in defs:
        if not a["path"].is_dir():
            out.append(f"hub.toml: エージェント {a['name']} の cwd がありません: {a['path']}")
        elif is_git_repo(a["path"]):
            toml_dirs.setdefault(a["path"].name, a["path"])
    actual = {p.name for p in env.iterdir() if p.is_dir() and not p.name.startswith(".") and is_git_repo(p)}
    for name, state in repos.items():
        exists = name in actual or (name in toml_dirs and toml_dirs[name].is_dir())
        planned = any(s in state for s in PLANNED)
        if not exists and not planned:
            out.append(f"MAP.md: {name} は「{state}」ですが、リポジトリがありません")
        if exists and planned:
            out.append(f"MAP.md: {name} は「{state}」ですが、リポジトリがあります")
    for name in sorted(actual - set(repos)):
        out.append(f"MAP.md: リポジトリ {name} が載っていません")
    for name in sorted(toml_dirs):
        if name not in repos:
            out.append(f"MAP.md: hub.toml のディレクトリ {name} が載っていません")

    # エージェント
    # NOTE: 移行期間は、旧い見出し「herdr 上のエージェント」も読む。
    rows = map_table(text, "エージェント") or map_table(text, "herdr 上のエージェント")
    in_map = {name_of(r[0]) for r in rows if r}
    in_toml = {a["name"] for a in defs}
    for name in sorted(in_map - in_toml):
        out.append(f"エージェント {name}: MAP.md にありますが hub.toml にありません")
    for name in sorted(in_toml - in_map):
        out.append(f"エージェント {name}: hub.toml にありますが MAP.md にありません")

    work_agents, work_labels = work_records(work_dir(env))
    if not backend.manual:
        live = {a.get("name") for a in backend.list_agents() if a.get("name")}
        for name in sorted(in_toml - live):
            out.append(f"エージェント {name}: hub.toml にありますが動いていません")
        for name in sorted(live - in_toml - in_map - work_agents):
            out.append(f"エージェント {name}: 動いていますが、MAP.md にも hub.toml にも作業にもありません")
        for name in sorted(work_agents - live):
            out.append(f"エージェント {name}: 進行中の作業に記録がありますが動いていません（hub-work resume）")

    # backend のレイアウト（herdr のワークスペースなど）
    out += backend.check_layout(work_labels)
    return out


def main() -> int:
    if any(a in ("-h", "--help") for a in sys.argv[1:]):
        print(__doc__.strip())
        return 0
    try:
        env, cfg = find_env()
        backend = backend_for(env, cfg)
        backend.check()
        problems = check(env, cfg, backend)
    except HubError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if backend.manual:
        print("note: backend が無いので、動いているエージェントとは照合していません")
    if not problems:
        print("ずれはありません")
        return 0
    for p in problems:
        print(f"- {p}")
    print(f"{len(problems)} 件のずれがあります")
    return 1


if __name__ == "__main__":
    sys.exit(main())
