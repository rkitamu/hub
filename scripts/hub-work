#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""作業を始め、閉じ、立て直す（commander のコマンド）。

usage:
  hub-work start <作業名> [--todo <id>] [--purpose <目的>] [--request <指示文>] [--kind <kind>]
                         commander と同じ場所に、作業名のタブで lead を立てる
  hub-work finish <作業名>   status.md に記録されたものだけを閉じ、archive へ移す（lead がいないときの予備）
  hub-work resume <作業名>   status.md から、欠けている lead・crew のタブを立て直す
  hub-work list [--all]      作業の一覧（--all で archive も）

lead は hub-lead、crew は hub-crew を使う（HUB_ROLE があれば止まる）。
hub.toml の session に書いたセッションのペインか、環境の中で実行する。
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import hub_work as hw  # noqa: E402
from hub_backend import backend_for  # noqa: E402
from hublib import HubError, find_env, work_dir  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(prog="hub-work", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("name")
    s.add_argument("--todo", type=int)
    s.add_argument("--purpose")
    s.add_argument("--request")
    s.add_argument("--kind", default="claude")
    sub.add_parser("finish").add_argument("name")
    sub.add_parser("resume").add_argument("name")
    sub.add_parser("list").add_argument("--all", action="store_true")
    a = p.parse_args()
    try:
        if a.cmd != "list":
            hw.require_role(None, f"hub-work {a.cmd}")
        env, cfg = find_env()
        backend = backend_for(env, cfg)
        backend.check()
        wd = work_dir(env)
        if a.cmd == "start":
            return hw.start(backend, env, wd, a.name, a.todo, a.purpose, a.request, a.kind)
        if a.cmd == "finish":
            rc = hw.finish(backend, env, wd, a.name)
            print("棚卸し: lead が済ませていなければ、この作業でのユーザーの指摘のうち今後も効くものを振り分けてください"
                  "（roles/commander.md の「レビューの記録」）")
            return rc
        if a.cmd == "resume":
            return hw.resume(backend, env, wd, a.name)
        return hw.list_works(backend, wd, a.all)
    except HubError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
