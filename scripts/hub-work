#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""作業ごとの文書・ワークスペース・エージェント・worktree を管理する。

usage:
  hub-work start <作業名> --repo <repo> [--repo <repo>…] [--todo <id>] [--worktree] [--purpose <目的>] [--request <依頼文>] [--kind <kind>]
  hub-work finish <作業名>   status.md に記録されたものだけを閉じ、archive へ移す
  hub-work resume <作業名>   status.md から、欠けているワークスペース・エージェントを立て直す
  hub-work list [--all]      作業の一覧（--all で archive も）

--repo は環境からの相対パス。hub.toml の session に書いたセッションのペインで実行する。
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import shutil
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from hublib import (HerdrError, HubError, agent_argv, claude_launch_args, dirty_files, find_env, git,  # noqa: E402
                    herdr, is_git_repo, live_agents, read_status, trust_worktree, untrust_worktree, work_dir,
                    workspaces, write_status)

NAME_RE = re.compile(r"[a-z][a-z0-9-]{0,19}")
AGENT_RE = re.compile(r"[a-z][a-z0-9_-]{0,31}")
# NOTE: 作業名 data の文書（archive/data/）まで /*/data/ に掛からないよう、打ち消す。
WORK_IGNORE = "# 検証データは git に入れない（hub-work が管理）\n/*/data/\n!/archive/data/\n/archive/*/data/\n"
BODY = "\n# {name}\n\n## 目的\n\n{purpose}\n\n## 進捗\n\n## 結果\n"


def slug(path: str) -> str:
    return re.sub(r"[^a-z0-9-]+", "-", Path(path).name.lower()).strip("-")


def label_map() -> dict[str, list[dict]]:
    out: dict[str, list[dict]] = {}
    for w in workspaces():
        out.setdefault(w["label"], []).append(w)
    return out


def one_workspace(labels: dict, label: str) -> dict | None:
    hits = labels.get(label, [])
    if len(hits) > 1:
        raise HubError(f"ラベル {label} のワークスペースが {len(hits)} 個あり、どれか決められません")
    return hits[0] if hits else None


# ── 作業ディレクトリ ─────────────────────────────────────────────


def ensure_work_repo(env: Path, wd: Path) -> None:
    hub_env = (env / "hub-env").resolve()
    if is_git_repo(hub_env):
        rel = wd.relative_to(hub_env).as_posix() + "/"
        if git(hub_env, "check-ignore", "-q", rel, check=False).returncode != 0:
            raise HubError(f"{rel} が hub-env の git から外れていません。hub-env/.gitignore に /{rel} を足してください")
    wd.mkdir(parents=True, exist_ok=True)
    if not is_git_repo(wd):
        git(wd, "init", "-q")
        print(f"作業文書の git リポジトリを初期化しました: {wd}")
    ensure_work_ignore(wd)


def ensure_work_ignore(wd: Path) -> None:
    """data/ を git から外す。既存のリポジトリで追跡済みの data/ も、手元のファイルは残して追跡だけ外す。"""
    ignore = wd / ".gitignore"
    text = ignore.read_text() if ignore.exists() else ""
    if WORK_IGNORE not in text:
        ignore.write_text(text + ("" if not text or text.endswith("\n") else "\n") + WORK_IGNORE)
    tracked = git(wd, "ls-files", "-z", "-ci", "--exclude-standard").stdout.split("\0")
    paths = [f for f in tracked if re.match(r"(archive/[^/]+|[^/]+)/data/", f)]
    for i in range(0, len(paths), 200):
        git(wd, "rm", "-q", "--cached", "--", *paths[i:i + 200])


def commit(wd: Path, message: str) -> None:
    git(wd, "add", "-A")
    if git(wd, "diff", "--cached", "--quiet", check=False).returncode != 0:
        git(wd, "commit", "-q", "-m", message)


def check_name(name: str, wd: Path) -> None:
    if not NAME_RE.fullmatch(name):
        raise HubError("作業名は英小文字で始まる英小文字・数字・ハイフンの 20 文字以内にしてください")
    if name == "archive":
        raise HubError("archive は作業名に使えません")
    if (wd / name).exists():
        raise HubError(f"同名の作業があります: {wd / name}")
    if (wd / "archive" / name).exists():
        raise HubError(f"同名の作業が archive にあります: {wd / 'archive' / name}")


def status_path(wd: Path, name: str) -> Path:
    if not NAME_RE.fullmatch(name) or name == "archive":
        raise HubError(f"作業名が不正です: {name}")
    path = wd / name / "status.md"
    if not path.is_file():
        raise HubError(f"作業がありません: {name}")
    return path


# ── 組み立て（start と resume で共通。あるものは作らない） ───────────


def work_access_args(doc_dir: Path, branch: str | None = None) -> list[str]:
    """作業のディレクトリへの書き込みと、worktree なら作業ブランチへの push までを許す claude の引数。"""
    d = str(doc_dir)
    # NOTE: --add-dir は別リポジトリの信頼確認で止まり、work 全体の信頼を求めるので使わない。
    tools = [f"Read(/{d}/**)", f"Edit(/{d}/**)", f"Write(/{d}/**)"]
    if branch:
        # NOTE: push は作業ブランチを名指しした形だけを許す。main や force push は確認に回る。
        tools += ["Bash(git add:*)", "Bash(git commit:*)", f"Bash(git push -u origin {branch})",
                  f"Bash(git push origin {branch})", "Bash(gh pr create:*)"]
    return ["--allowedTools", *tools]


def register_trust(env: Path, name: str, wt: dict) -> None:
    """hub-work が作った worktree に限り、元のリポジトリが信頼済みなら信頼済みとして登録する。"""
    source = (env / wt["repo"]).resolve()
    tree = Path(wt["path"]).resolve()
    try:
        common = lambda p: git(p, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
        if (tree != (env / ".hub-worktrees" / name / slug(wt["repo"])).resolve() or wt["branch"] != f"work/{name}"
                or git(tree, "symbolic-ref", "--short", "HEAD").stdout.strip() != wt["branch"]
                or common(tree) != common(source)):
            raise HubError(f"hub-work が作った worktree と確認できません: {tree}")
        if trust_worktree(source, tree):
            wt["trusted"] = True
    except HubError as e:
        print(f"warning: worktree を信頼済みにできませんでした: {e}", file=sys.stderr)


def start_agent(agent: dict, pane: str, launch: list[str], doc_dir: Path, branch: str | None = None) -> None:
    kind = agent.get("kind", "claude")
    cmd = ["agent", "start", agent["name"], "--kind", kind, "--pane", pane]
    if args := agent_argv(kind, launch, [], work_access_args(doc_dir, branch)):
        cmd += ["--", *args]
    deadline = time.monotonic() + 30
    while True:
        try:
            herdr(*cmd)
            return
        except HerdrError as e:
            # 起動はしたが確認ダイアログ（初回のフォルダ信頼など）で止まっている場合は、ユーザーに任せる
            if e.code == "agent_not_ready":
                print(f"note: {agent['name']} が確認待ちです。そのタブで答えてください", file=sys.stderr)
                return
            # NOTE: 作成直後のペインはシェルが起動しきっておらず、agent_pane_busy で弾かれる。
            if e.code != "agent_pane_busy" or time.monotonic() > deadline:
                raise
            time.sleep(0.5)


def open_worktree(wt: dict, repo: Path) -> dict:
    path = Path(wt["path"])
    if path.exists():
        return herdr("worktree", "open", "--cwd", str(repo), "--path", str(path),
                     "--label", wt["workspace"], "--no-focus")["result"]
    path.parent.mkdir(parents=True, exist_ok=True)
    if git(repo, "rev-parse", "--verify", "-q", f"refs/heads/{wt['branch']}", check=False).returncode == 0:
        git(repo, "worktree", "add", str(path), wt["branch"])
        return herdr("worktree", "open", "--cwd", str(repo), "--path", str(path),
                     "--label", wt["workspace"], "--no-focus")["result"]
    return herdr("worktree", "create", "--cwd", str(repo), "--branch", wt["branch"], "--path", str(path),
                 "--label", wt["workspace"], "--no-focus")["result"]


def ensure(env: Path, meta: dict, doc_dir: Path) -> list[str]:
    """記録の通りに揃える。新しく起動したエージェントの名前を返す。"""
    launch = claude_launch_args(env)
    started: list[str] = []
    alive = {a.get("name") for a in live_agents()}
    worktrees = {w["repo"]: w for w in meta["worktrees"]}
    fresh: dict[str, str] = {}  # ワークスペースのラベル → まだ使っていない最初のペイン
    for agent in meta["agents"]:
        label = agent["workspace"]
        labels = label_map()
        ws = one_workspace(labels, label)
        if not ws:
            if agent["repo"] in worktrees:
                wt = worktrees[agent["repo"]]
                before = {w["workspace_id"] for w in workspaces()}
                res = open_worktree(wt, (env / agent["repo"]).resolve())
                # NOTE: 元のリポジトリのワークスペースが無いと、herdr が親を自動で作る。finish で片付けるために記録する。
                for w in workspaces():
                    if w["workspace_id"] not in before and w["workspace_id"] != res["workspace"]["workspace_id"]:
                        wt["source"] = {"id": w["workspace_id"], "label": w["label"]}
            else:
                res = herdr("workspace", "create", "--cwd", agent["cwd"], "--label", label, "--no-focus")["result"]
            herdr("tab", "rename", res["tab"]["tab_id"], slug(agent["repo"]))
            ws = res["workspace"]
            fresh[label] = res["root_pane"]["pane_id"]
        if agent["name"] in alive:
            continue
        pane = fresh.pop(label, None)
        if not pane:
            res = herdr("tab", "create", "--workspace", ws["workspace_id"], "--cwd", agent["cwd"],
                        "--label", slug(agent["repo"]), "--no-focus")["result"]
            pane = res["root_pane"]["pane_id"]
        wt = worktrees.get(agent["repo"])
        if wt and agent.get("kind", "claude") == "claude":
            register_trust(env, doc_dir.name, wt)
        start_agent(agent, pane, launch, doc_dir, wt["branch"] if wt else None)
        started.append(agent["name"])
    return started


def brief(env: Path, name: str, path: Path, request: str | None, meta: dict) -> str:
    head = f"あなたは作業「{name}」の担当です。作業文書は {path} です。まず読んでください。"
    rules = (f"消えて困るものは作業コピー（worktree）に置かないでください。finish で削除されます。メモ（手順・調査メモ・再現方法）は "
             f"{path.parent}/runbook.md に、検証データは {path.parent}/data/ に置いてください。秘密情報はどちらにも書かないでください。"
             "担当のリポジトリのほかに書き込んでよいのは、この作業のディレクトリだけです。\n"
             "進捗と結果は、先にこの status.md の本文（進捗・結果）へ書いてください。front matter の state は、"
             "止まったら blocked にします。そのあと herdr agent prompt hub \"<作業名と要約>\" で司令塔へ通知してください。"
             "通知が agent_blocked などで拒否されたら、少し待って再送してください。"
             "timeout の場合は届いた可能性があるので、herdr agent read hub で確かめてから再送してください。"
             f"\n作業ブランチ work/{name} へのコミット、push（git push -u origin work/{name}）、PR 作成まで行ってください。"
             "この範囲はユーザーの承認済みです。remote が無ければコミットまでで構いません。"
             + ("" if meta["worktrees"] else f"main / master にいるときは、先に work/{name} を切ってください。")
             + "main / master への直接のコミットと push、PR のマージ、rebase、force push はしないでください。")
    if any((env / r).resolve() == (env / "hub-env").resolve() for r in meta["repos"]):
        rules += ("\nhub-env の CLAUDE.md は司令塔向けですが、あなたは司令塔ではなく、この作業の担当です。"
                  "worktree の中のファイルを変更してください。")
    return "\n".join(x for x in (head, request, rules) if x)


def send_briefs(names: list[str], text: str, doc_dir: Path) -> list[str]:
    """依頼を送り、届けられなかったエージェントを返す。届かなかった依頼文は作業ディレクトリに残す。"""
    undelivered = []
    saved = doc_dir / "undelivered-brief.md"
    for name in names:
        try:
            herdr("agent", "prompt", name, text)
        except HerdrError as e:
            undelivered.append(name)
            saved.write_text(text + "\n")
            print(f"warning: {name} に依頼が届いていません（{e.code or e}）。ユーザーに確認し、そのタブの確認に答えてもらってから、"
                  f"次のコマンドで再送してください:\n  herdr agent prompt {name} \"$(cat {shlex.quote(str(saved))})\"",
                  file=sys.stderr)
    if not undelivered:
        saved.unlink(missing_ok=True)
    return undelivered


# ── コマンド ───────────────────────────────────────────────────


def cmd_start(a: argparse.Namespace, env: Path, wd: Path) -> int:
    ensure_work_repo(env, wd)
    check_name(a.name, wd)
    claude_launch_args(env)  # 設定が壊れていれば、何も作らずに止まる
    if a.todo is not None and a.todo < 0:
        raise HubError("--todo は TODO の id にしてください")

    label = f"w-{a.name}"
    repos: list[str] = list(dict.fromkeys(a.repo))
    slugs = [slug(r) for r in repos]
    if len(set(slugs)) != len(slugs):
        raise HubError("名前が同じリポジトリは同時に指定できません")

    agents, trees = [], []
    for i, (repo, s) in enumerate(zip(repos, slugs)):
        path = (env / repo).resolve()
        if not path.is_dir():
            raise HubError(f"リポジトリがありません: {path}")
        if path == (env / "hub-env").resolve():
            # NOTE: 司令塔と同じ checkout を触らないよう worktree に限る。CLAUDE.md が司令塔向けなので、役割は依頼文で渡す。
            if not a.worktree or not a.request:
                raise HubError("hub-env を対象にするときは --worktree と --request を付けてください")
        ws_label = label
        cwd = path
        if a.worktree:
            if not is_git_repo(path):
                raise HubError(f"git リポジトリではないので worktree を作れません: {path}")
            ws_label = label if i == 0 else f"{label}--{s}"
            cwd = env / ".hub-worktrees" / a.name / s
            branch = f"work/{a.name}"
            if cwd.exists():
                raise HubError(f"worktree の場所が既にあります: {cwd}")
            if git(path, "rev-parse", "--verify", "-q", f"refs/heads/{branch}", check=False).returncode == 0:
                raise HubError(f"ブランチが既にあります: {branch}（{path}）")
            trees.append({"repo": repo, "path": str(cwd), "branch": branch, "workspace": ws_label})
        agent = label if len(repos) == 1 else f"{label}-{s}"
        if not AGENT_RE.fullmatch(agent):
            raise HubError(f"エージェント名に使えません: {agent}。作業名を短くしてください")
        agents.append({"name": agent, "repo": repo, "cwd": str(cwd), "workspace": ws_label, "kind": a.kind})

    labels = label_map()
    for ws_label in {x["workspace"] for x in agents}:
        if ws_label in labels:
            raise HubError(f"同じ名前のワークスペースが既にあります: {ws_label}")
    alive = {x.get("name") for x in live_agents()}
    for x in agents:
        if x["name"] in alive:
            raise HubError(f"同じ名前のエージェントが既にいます: {x['name']}")

    # 作るものを先に記録する。途中で失敗しても、finish と resume が記録から続けられる。
    path = wd / a.name / "status.md"
    path.parent.mkdir(parents=True)
    meta = {"state": "active", "todo": a.todo, "repos": repos, "workspace": label, "agents": agents, "worktrees": trees}
    purpose = "\n\n".join(x for x in (a.purpose, a.request and f"依頼: {a.request}") if x) or "（未記入）"
    body = BODY.format(name=a.name, purpose=purpose)
    write_status(path, meta, body)
    commit(wd, f"start {a.name}")
    try:
        started = ensure(env, meta, path.parent)
    except HubError as e:
        raise HubError(f"{e}\n途中まで作りました。hub-work resume {a.name} で続けるか、hub-work finish {a.name} で片付けてください")
    finally:
        write_status(path, meta, body)
        commit(wd, f"record {a.name}")
    undelivered = send_briefs(started, brief(env, a.name, path, a.request, meta), path.parent) if a.request else []
    commit(wd, f"brief {a.name}")
    print(f"作業 {a.name} を始めました: {path}")
    print(f"エージェント: {', '.join(x['name'] for x in agents)}")
    return 1 if undelivered else 0


def cmd_resume(a: argparse.Namespace, env: Path, wd: Path) -> int:
    path = status_path(wd, a.name)
    meta, body = read_status(path)
    if meta["state"] == "done":
        raise HubError(f"作業 {a.name} は done です")
    ensure_work_ignore(wd)
    try:
        started = ensure(env, meta, path.parent)
    finally:
        write_status(path, meta, body)
        commit(wd, f"resume {a.name}")
    undelivered = send_briefs(started, brief(env, a.name, path, "hub-reset などで中断した作業の再開です。status.md の進捗から続けてください。", meta),
                              path.parent)
    commit(wd, f"brief {a.name}")
    print(f"作業 {a.name} を立て直しました（起動: {', '.join(started) or 'なし'}）")
    return 1 if undelivered else 0


def close_auto_created(meta: dict) -> None:
    """herdr が worktree のために自動で作った親を閉じる。使われている形跡があれば残す。"""
    for wt in meta["worktrees"]:
        src = wt.get("source")
        if not src:
            continue
        every = workspaces()
        ws = next((w for w in every if w["workspace_id"] == src["id"] and w["label"] == src["label"]), None)
        if not ws:
            continue
        key = (ws.get("worktree") or {}).get("repo_key")
        linked = any((o.get("worktree") or {}).get("repo_key") == key and (o.get("worktree") or {}).get("is_linked_worktree")
                     for o in every)
        has_agent = any(x.get("workspace_id") == ws["workspace_id"] for x in live_agents())
        if linked or has_agent or ws.get("pane_count") != 1 or ws.get("tab_count") != 1:
            print(f"note: 自動で作られた {src['label']} は使われているので残しました", file=sys.stderr)
            continue
        herdr("workspace", "close", ws["workspace_id"])
        print(f"自動で作られたワークスペースを閉じました: {src['label']}")


def cmd_finish(a: argparse.Namespace, env: Path, wd: Path) -> int:
    path = status_path(wd, a.name)
    meta, body = read_status(path)
    dest = wd / "archive" / a.name
    if dest.exists():
        raise HubError(f"archive に同名の作業があります: {dest}")

    # ── 何かを閉じる前に、止まる条件をすべて調べる ──
    all_ws = workspaces()
    own = {meta["workspace"], *(x["workspace"] for x in meta["agents"]), *(x["workspace"] for x in meta["worktrees"])}
    here = os.environ.get("HERDR_WORKSPACE_ID")
    if any(w["workspace_id"] == here and w["label"] in own for w in all_ws):
        raise HubError("作業自身のワークスペースからは finish できません。司令塔で実行してください")
    labels = label_map()
    for label in own:
        one_workspace(labels, label)
    for wt in meta["worktrees"]:
        tree = Path(wt["path"])
        if tree.exists() and (dirty := dirty_files(tree)):
            raise HubError(f"worktree に未コミットの変更があるので止めました: {tree}\n" + "\n".join(dirty[:10]))
    tree_labels = {x["workspace"] for x in meta["worktrees"]}
    for label in own - tree_labels:
        ws = one_workspace(labels, label)
        info = (ws or {}).get("worktree") or {}
        if info and not info.get("is_linked_worktree") and any(
                (o.get("worktree") or {}).get("repo_key") == info.get("repo_key")
                and (o.get("worktree") or {}).get("is_linked_worktree") for o in all_ws):
            raise HubError(f"{label} には他の worktree のワークスペースがつながっているので閉じられません。"
                           "他の作業を巻き込むため、先にそちらを finish してください")

    # ── 閉じる ──
    for wt in meta["worktrees"]:
        ws = one_workspace(label_map(), wt["workspace"])
        tree = Path(wt["path"])
        if ws:
            herdr("worktree", "remove", "--workspace", ws["workspace_id"])
        elif tree.exists():
            git((env / wt["repo"]).resolve(), "worktree", "remove", str(tree))
        print(f"worktree を外しました: {tree}（ブランチ {wt['branch']} は残しています）")
        if wt.get("trusted"):
            try:
                untrust_worktree(tree.resolve())
            except HubError as e:
                print(f"warning: worktree の信頼の登録を外せませんでした: {e}", file=sys.stderr)
    for label in own - tree_labels:
        if ws := one_workspace(label_map(), label):
            herdr("workspace", "close", ws["workspace_id"])
            print(f"ワークスペースを閉じました: {label}")
    close_auto_created(meta)
    parent = env / ".hub-worktrees" / a.name
    if parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()

    meta["state"] = "done"
    write_status(path, meta, body)
    dest.parent.mkdir(exist_ok=True)
    shutil.move(str(wd / a.name), str(dest))
    ensure_work_ignore(wd)
    commit(wd, f"finish {a.name}")
    print(f"作業 {a.name} を archive へ移しました: {dest}")
    print("棚卸し: この作業でのユーザーの指摘のうち、今後も効くものを rules へ振り分けてください（commander.md の「レビューの記録」）")
    return 0


def cmd_list(a: argparse.Namespace, env: Path, wd: Path) -> int:
    rows = []
    roots = [(wd, "")] + ([(wd / "archive", "archive/")] if a.all else [])
    alive = {x.get("name"): x.get("agent_status") for x in live_agents()}
    for root, prefix in roots:
        if not root.is_dir():
            continue
        for d in sorted(p for p in root.iterdir() if p.is_dir() and p.name not in ("archive", ".git")):
            try:
                meta, _ = read_status(d / "status.md")
            except (OSError, HubError) as e:
                rows.append((prefix + d.name, "error", "-", str(e), "-"))
                continue
            st = ", ".join(f"{x['name']}={alive.get(x['name'], '停止')}" for x in meta["agents"]) if not prefix else "-"
            rows.append((prefix + d.name, meta["state"], str(meta["todo"] or "-"), ",".join(meta["repos"]), st))
    if not rows:
        print("作業はありません")
    for row in rows:
        print("\t".join(row))
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="hub-work", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start")
    s.add_argument("name")
    s.add_argument("--repo", action="append", required=True)
    s.add_argument("--todo", type=int)
    s.add_argument("--worktree", action="store_true")
    s.add_argument("--purpose")
    s.add_argument("--request")
    s.add_argument("--kind", default="claude")
    sub.add_parser("finish").add_argument("name")
    sub.add_parser("resume").add_argument("name")
    sub.add_parser("list").add_argument("--all", action="store_true")
    a = p.parse_args()
    try:
        env, _ = find_env()
        wd = work_dir(env)
        return {"start": cmd_start, "finish": cmd_finish, "resume": cmd_resume, "list": cmd_list}[a.cmd](a, env, wd)
    except HubError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
