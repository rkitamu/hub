#!/usr/bin/env python3
"""git フックを飛ばす操作を拒否する PreToolUse フック（Bash 用）。

usage: hub-commit-guard [--allow <パス>]…   （--allow は互換のために受け付け、無視する）

拒否するもの:
- git の各サブコマンドの --no-verify（commit・push・merge・pull・rebase・am など）と git commit -n
- git -c core.hooksPath=… と git --config-env=core.hooksPath=…
- 環境変数 GIT_CONFIG_PARAMETERS / GIT_CONFIG_KEY_<n> での core.hooksPath の指定
- git config による core.hooksPath の設定・削除（読むだけなら許可）

Bash のコマンドを実行せずに解析し、git -C・cd・複合コマンド・サブシェル・$(...)・bash -c・eval・
env / sudo / xargs / find -exec・git のエイリアスを辿る。
main / master の保護は、各リポジトリの git フックが受け持つ。

対象外: スクリプトファイルの中身、実行時に決まる文字列の組み立て、Bash 以外の経路、
.git/config の直接の編集、フックを通らない操作（update-ref など）。
誤操作の防止であり、セキュリティの境界ではない。
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

UNKNOWN = "\x03"
VAR = re.compile("\x01(\\w+)\x02")
MAX_DEPTH = 8
KEYWORDS = {"{", "}", "!", "then", "do", "else", "elif", "if", "while", "until", "time", "coproc", "done", "fi", "esac"}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
# 引数の次の語を値として取る、ラッパーのオプション
WRAPPERS: dict[str, set[str]] = {
    "command": set(), "builtin": set(), "exec": {"-a"}, "nohup": set(), "setsid": set(),
    "sudo": {"-u", "-g", "-h", "-p", "-C", "-D", "-R", "-T", "-U"},
    "nice": {"-n"}, "ionice": {"-c", "-n", "-p"}, "stdbuf": {"-i", "-o", "-e"},
    "xargs": {"-I", "-n", "-P", "-L", "-d", "-E", "-s", "-a"},
    "timeout": {"-s", "-k"},
}
# 変数を設定するシェルの組み込みコマンド
SETTERS = {"export", "declare", "typeset", "local", "readonly"}
# git commit で次の語を値として取るオプション（メッセージの中の --no-verify や -n を見間違えないため）
COMMIT_VALUE_OPTS = {"-m", "-F", "-C", "-c", "-t", "--message", "--file", "--reuse-message", "--reedit-message", "--template",
                     "--author", "--date", "--fixup", "--squash", "--trailer", "--cleanup", "--pathspec-from-file"}
# git commit の短いオプションのうち、値を取るもの（-S と -u は値を続けて書く任意の値）
COMMIT_SHORT_VALUE = set("mFCctSu")
# git config で次の語を値として取るオプション
CONFIG_VALUE_OPTS = {"-f", "--file", "--blob", "--type", "--default", "--comment", "--value"}
CONFIG_READ_OPTS = {"--get", "--get-all", "--get-regexp", "--get-urlmatch", "-l", "--list", "--get-color", "--get-colorbool"}
CONFIG_READ_SUBS = {"get", "list"}
GIT_VALUE_OPTS = {"--git-dir", "--work-tree", "--namespace", "--super-prefix"}
# エイリアスを調べなくてよい、よく使うサブコマンド
GIT_BUILTINS = {"status", "add", "diff", "log", "show", "fetch", "pull", "push", "branch", "rev-parse", "remote", "stash",
                "restore", "reset", "merge", "rebase", "tag", "config", "init", "clone", "worktree", "ls-files", "commit",
                "symbolic-ref", "blame", "grep", "rm", "mv", "cherry-pick", "revert", "describe", "submodule", "switch",
                "checkout", "am"}
HOOKS_PATH = "core.hookspath"


def is_no_verify(a: str) -> bool:
    """--no-verify と、git が受け付ける一意な省略形。"""
    return len(a) >= len("--no-veri") and "--no-verify".startswith(a)


def names_hooks_path(text: str) -> bool:
    return HOOKS_PATH in text.lower()


class Denied(Exception):
    pass


# ── シェルの字句解析（実行はしない） ─────────────────────────────


@dataclass
class Cmd:
    words: list[str] = field(default_factory=list)
    subs: list[list] = field(default_factory=list)
    heredocs: list[str] = field(default_factory=list)
    prev_op: str = ";"
    next_op: str | None = None


@dataclass
class Group:
    items: list
    prev_op: str = ";"
    next_op: str | None = None


class Parser:
    def __init__(self, s: str):
        self.s = s
        self.i = 0
        self.pending: list[tuple[Cmd, str, bool]] = []

    def peek(self, text: str) -> bool:
        return self.s.startswith(text, self.i)

    def parse(self, closer: str | None = None) -> list:
        s = self.s
        items: list = []
        cur = Cmd()
        word: str | None = None
        skip = False
        prev = ";"

        def flush_word() -> None:
            nonlocal word, skip
            if word is not None:
                if not skip:
                    cur.words.append(word)
                skip = False
                word = None

        def flush_cmd(op: str) -> None:
            nonlocal cur, prev
            flush_word()
            if cur.words or cur.subs or cur.heredocs:
                cur.prev_op, cur.next_op = prev, op
                items.append(cur)
                cur = Cmd()
            elif items and items[-1].next_op is None:
                items[-1].next_op = op
            prev = op

        while self.i < len(s):
            c = s[self.i]
            if c in " \t":
                flush_word()
                self.i += 1
            elif c == "\n":
                flush_cmd(";")
                self.i += 1
                self.read_heredocs()
            elif c == "#" and word is None:
                while self.i < len(s) and s[self.i] != "\n":
                    self.i += 1
            elif c == ";":
                flush_cmd(";")
                self.i += 2 if self.peek(";;") else 1
            elif c == "&" and self.s[self.i + 1:self.i + 2] == ">":
                flush_word()
                self.i += 3 if self.peek("&>>") else 2
                skip = True
            elif c == "&":
                op = "&&" if self.peek("&&") else "&"
                flush_cmd(op)
                self.i += len(op)
            elif c == "|":
                op = "||" if self.peek("||") else "|&" if self.peek("|&") else "|"
                flush_cmd(op)
                self.i += len(op)
            elif c in "<>":
                if word is not None and word.isdigit():
                    word = None
                flush_word()
                if self.peek("<(") or self.peek(">("):
                    self.i += 2
                    cur.subs.append(self.parse(")"))
                    word = UNKNOWN
                elif self.peek("<<<"):
                    self.i += 3
                    skip = True
                elif self.peek("<<"):
                    self.i += 2
                    strip = self.peek("-")
                    self.i += 1 if strip else 0
                    self.pending.append((cur, self.read_delim(), strip))
                else:
                    self.i += 1
                    while self.i < len(s) and s[self.i] in ">&|":
                        self.i += 1
                    skip = True
            elif c == "(":
                if word is not None and self.s[self.i + 1:self.i + 2] == ")":  # 関数定義 f()
                    word = None
                    cur = Cmd()
                    self.i += 2
                    continue
                flush_word()
                self.i += 1
                group = Group(self.parse(")"), prev_op=prev)
                items.append(group)
            elif c == ")":
                self.i += 1
                if closer == ")":
                    flush_cmd(";")
                    return items
                word = None  # case のパターン
                cur = Cmd()
            elif c == "'":
                end = s.find("'", self.i + 1)
                if end < 0:
                    raise ValueError("引用符が閉じていません")
                word = (word or "") + s[self.i + 1:end]
                self.i = end + 1
            elif c == '"':
                word = (word or "") + self.read_dquote(cur)
            elif c == "\\":
                if self.s[self.i + 1:self.i + 2] != "\n":
                    word = (word or "") + self.s[self.i + 1:self.i + 2]
                self.i += 2
            elif c == "`":
                word = (word or "") + self.read_backtick(cur)
            elif c == "$":
                word = (word or "") + self.read_dollar(cur)
            else:
                word = (word or "") + c
                self.i += 1
        if closer:
            raise ValueError("括弧が閉じていません")
        flush_cmd(";")
        return items

    def read_delim(self) -> str:
        s = self.s
        while self.i < len(s) and s[self.i] in " \t":
            self.i += 1
        out = ""
        while self.i < len(s) and s[self.i] not in " \t\n;&|<>()":
            c = s[self.i]
            if c in "'\"":
                end = s.find(c, self.i + 1)
                if end < 0:
                    raise ValueError("引用符が閉じていません")
                out += s[self.i + 1:end]
                self.i = end + 1
            elif c == "\\":
                out += s[self.i + 1:self.i + 2]
                self.i += 2
            else:
                out += c
                self.i += 1
        return out

    def read_heredocs(self) -> None:
        for cmd, delim, strip in self.pending:
            lines = []
            while self.i < len(self.s):
                end = self.s.find("\n", self.i)
                end = len(self.s) if end < 0 else end
                line = self.s[self.i:end]
                self.i = min(end + 1, len(self.s))
                if (line.lstrip("\t") if strip else line) == delim:
                    break
                lines.append(line)
            cmd.heredocs.append("\n".join(lines))
        self.pending = []

    def read_dquote(self, cur: Cmd) -> str:
        s = self.s
        self.i += 1
        out = ""
        while self.i < len(s):
            c = s[self.i]
            if c == '"':
                self.i += 1
                return out
            if c == "\\":
                nxt = s[self.i + 1:self.i + 2]
                if nxt == "\n":
                    pass
                elif nxt in ('$', '`', '"', "\\"):
                    out += nxt
                else:
                    out += c + nxt
                self.i += 2
            elif c == "$":
                out += self.read_dollar(cur)
            elif c == "`":
                out += self.read_backtick(cur)
            else:
                out += c
                self.i += 1
        raise ValueError("引用符が閉じていません")

    def read_backtick(self, cur: Cmd) -> str:
        s = self.s
        j = self.i + 1
        body = ""
        while j < len(s) and s[j] != "`":
            if s[j] == "\\" and j + 1 < len(s):
                body += s[j + 1]
                j += 2
            else:
                body += s[j]
                j += 1
        if j >= len(s):
            raise ValueError("バッククォートが閉じていません")
        self.i = j + 1
        cur.subs.append(Parser(body).parse())
        return UNKNOWN

    def read_dollar(self, cur: Cmd) -> str:
        s = self.s
        if self.peek("$(("):
            depth, j = 0, self.i + 1
            while j < len(s):
                depth += (s[j] == "(") - (s[j] == ")")
                j += 1
                if depth == 0:
                    break
            self.i = j
            return UNKNOWN
        if self.peek("$("):
            self.i += 2
            cur.subs.append(self.parse(")"))
            return UNKNOWN
        if self.peek("${"):
            end = s.find("}", self.i)
            if end < 0:
                raise ValueError("${ が閉じていません")
            name = s[self.i + 2:end]
            self.i = end + 1
            return f"\x01{name}\x02" if re.fullmatch(r"\w+", name) else UNKNOWN
        if self.peek("$'"):
            end = s.find("'", self.i + 2)
            if end < 0:
                raise ValueError("引用符が閉じていません")
            out = s[self.i + 2:end]
            self.i = end + 1
            return out
        m = re.compile(r"\$(\w+)").match(s, self.i)
        if m:
            self.i = m.end()
            return f"\x01{m.group(1)}\x02"
        if s[self.i + 1:self.i + 2] in ("?", "!", "#", "@", "*", "-"):
            self.i += 2
            return UNKNOWN
        self.i += 1
        return "$"



# ── 判定 ───────────────────────────────────────────────────────


@dataclass
class State:
    cwd: Path | None
    vars: dict[str, str] = field(default_factory=dict)
    exported: dict[str, str] = field(default_factory=dict)

    def copy(self) -> "State":
        return State(self.cwd, dict(self.vars), dict(self.exported))


class Guard:
    # ── 語の展開 ──

    def expand(self, word: str, st: State, temp: dict[str, str]) -> str:
        def repl(m: re.Match) -> str:
            name = m.group(1)
            for scope in (temp, st.exported, st.vars, os.environ):
                if name in scope:
                    return scope[name]
            return UNKNOWN
        out = VAR.sub(repl, word)
        if out == "~" or out.startswith("~/"):
            out = str(Path.home()) + out[1:]
        return out

    @staticmethod
    def chdir(base: Path | None, target: str) -> Path | None:
        if UNKNOWN in target or base is None and not target.startswith("/"):
            return None
        return Path(os.path.normpath(base / target if base else target))

    @staticmethod
    def check_assign(name: str, value: str) -> None:
        """git の設定を渡す環境変数で core.hooksPath を指定していないか。"""
        if name == "GIT_CONFIG_PARAMETERS" or name.startswith("GIT_CONFIG_KEY_"):
            if names_hooks_path(value) or UNKNOWN in value:
                raise Denied(f"{name} で core.hooksPath を指定する操作は拒否しました。git フックを飛ばさないでください")

    # ── 走査 ──

    def walk(self, items: list, st: State, depth: int) -> None:
        if depth > MAX_DEPTH:
            raise Denied("コマンドの入れ子が深すぎて判定できません")
        for item in items:
            if isinstance(item, Group):
                self.walk(item.items, st.copy(), depth + 1)
                continue
            for sub in item.subs:
                self.walk(sub, st.copy(), depth + 1)
            # パイプやバックグラウンドの各段はサブシェルなので、cd などは後に残らない
            isolated = item.prev_op in ("|", "|&") or item.next_op in ("|", "|&", "&")
            self.run(list(item.words), st.copy() if isolated else st, item, {}, depth)

    def run_text(self, text: str, st: State, depth: int) -> None:
        self.walk(Parser(text).parse(), st.copy(), depth + 1)

    def run(self, words: list[str], st: State, item: Cmd, temp: dict[str, str], depth: int) -> None:
        if depth > MAX_DEPTH:
            raise Denied("コマンドの入れ子が深すぎて判定できません")
        while words and words[0] in KEYWORDS:
            words = words[1:]
        temp = dict(temp)
        while words and (m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", words[0], re.S)):
            temp[m.group(1)] = self.expand(m.group(2), st, temp)
            self.check_assign(m.group(1), temp[m.group(1)])
            words = words[1:]
        if not words:
            st.vars.update(temp)
            return
        words = [self.expand(w, st, temp) for w in words]
        name = os.path.basename(words[0])
        args = words[1:]

        if UNKNOWN in words[0]:  # $GIT commit のように、実行時に決まるコマンド
            self.git(args, st, temp, depth)
            return
        if name == "git":
            self.git(args, st, temp, depth)
        elif name in ("cd", "pushd"):
            rest = [a for a in args if a not in ("-L", "-P", "-e", "--")]
            target = rest[0] if rest else str(Path.home())
            if target == "-":
                st.cwd = None
            else:
                new = self.chdir(st.cwd, target)
                # 存在しない場所への cd は失敗するので、今の場所のまま
                if new is None or new.is_dir():
                    st.cwd = new
        elif name == "popd":
            st.cwd = None
        elif name in SETTERS:
            for a in args:
                if m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", a, re.S):
                    self.check_assign(m.group(1), m.group(2))
                    st.exported[m.group(1)] = m.group(2)
                elif a in st.vars:
                    st.exported[a] = st.vars[a]
        elif name == "unset":
            for a in args:
                st.vars.pop(a, None)
                st.exported.pop(a, None)
        elif name == "eval":
            self.run_text(" ".join(args), self.with_temp(st, temp), depth)
        elif name == "env":
            self.run_env(args, st, item, temp, depth)
        elif name == "find":
            for i, a in enumerate(args):
                if a in ("-exec", "-execdir", "-ok", "-okdir"):
                    rest = args[i + 1:]
                    end = next((j for j, x in enumerate(rest) if x in (";", "+")), len(rest))
                    self.run(rest[:end], st.copy(), item, temp, depth + 1)
        elif name in SHELLS:
            self.run_shell(args, st, item, temp, depth)
        elif name in WRAPPERS:
            self.run_wrapper(name, args, st, item, temp, depth)

    @staticmethod
    def with_temp(st: State, temp: dict[str, str]) -> State:
        out = st.copy()
        out.exported.update(temp)
        return out

    def run_env(self, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        st = st.copy()
        temp = dict(temp)
        i = 0
        while i < len(args):
            a = args[i]
            if a in ("-u", "--unset"):
                temp.pop(args[i + 1] if i + 1 < len(args) else "", None)
                i += 2
            elif a in ("-C", "--chdir"):
                st.cwd = self.chdir(st.cwd, args[i + 1]) if i + 1 < len(args) else None
                i += 2
            elif a.startswith("--chdir="):
                st.cwd = self.chdir(st.cwd, a.split("=", 1)[1])
                i += 1
            elif a in ("-S", "--split-string"):
                rest = " ".join(args[i + 1:])
                self.run_text(rest, self.with_temp(st, temp), depth)
                return
            elif a.startswith("-"):
                i += 1
            elif m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", a, re.S):
                self.check_assign(m.group(1), m.group(2))
                temp[m.group(1)] = m.group(2)
                i += 1
            else:
                break
        self.run(args[i:], st, item, temp, depth + 1)

    def run_shell(self, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        for i, a in enumerate(args):
            if a.startswith("-") and not a.startswith("--") and "c" in a:
                if i + 1 < len(args):
                    body = args[i + 1]
                    if UNKNOWN in body and re.search(r"no-ver|hookspath|GIT_CONFIG", body, re.I):
                        raise Denied("bash -c の中身を判定できません")
                    self.run_text(body, self.with_temp(st, temp), depth)
                return
            if not a.startswith("-"):
                return  # スクリプトファイルは読まない
        for body in item.heredocs:
            self.run_text(body, self.with_temp(st, temp), depth)

    def run_wrapper(self, name: str, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        if name == "command" and any(a in ("-v", "-V") for a in args):
            return
        takes_value = WRAPPERS[name]
        i = 0
        while i < len(args) and args[i].startswith("-"):
            if args[i] == "--":
                i += 1
                break
            i += 2 if args[i] in takes_value else 1
        if name == "timeout":
            i += 1  # 時間の引数
        elif name == "sudo":
            while i < len(args) and re.fullmatch(r"[A-Za-z_]\w*=.*", args[i], re.S):
                self.check_assign(*args[i].split("=", 1))
                i += 1
        self.run(args[i:], st, item, temp, depth + 1)

    # ── git ──

    def git(self, args: list[str], st: State, temp: dict, depth: int) -> None:
        cwd = st.cwd
        opts: list[str] = []
        i = 0
        while i < len(args):
            a = args[i]
            if a == "-C":
                cwd = self.chdir(cwd, args[i + 1]) if i + 1 < len(args) else None
                i += 2
            elif a in ("-c", "--config-env") or a.startswith("--config-env="):
                value = a.split("=", 1)[1] if "=" in a else (args[i + 1] if i + 1 < len(args) else "")
                key = value.split("=", 1)[0]
                if names_hooks_path(key) or UNKNOWN in key:
                    raise Denied(f"git {a.split('=', 1)[0]} で core.hooksPath を指定する操作は拒否しました。"
                                 "git フックを飛ばさないでください")
                if a == "-c":
                    opts += ["-c", value]
                i += 1 if "=" in a else 2
            elif a.startswith("-c") and len(a) > 2:  # -ckey=value
                if names_hooks_path(a[2:].split("=", 1)[0]):
                    raise Denied("git -c で core.hooksPath を指定する操作は拒否しました。git フックを飛ばさないでください")
                i += 1
            elif a in GIT_VALUE_OPTS:
                opts += [f"{a}={args[i + 1]}"] if i + 1 < len(args) else []
                i += 2
            elif a.startswith("-") and UNKNOWN not in a:
                i += 1
            else:
                break
        if i >= len(args):
            return
        sub, rest = args[i], args[i + 1:]

        if sub == "commit" or UNKNOWN in sub:
            self.check_commit(rest)
        else:
            for a in rest:
                if a == "--":
                    break
                if is_no_verify(a):
                    raise Denied(f"git {sub} --no-verify は拒否しました。git フックを飛ばさないでください")
        if sub == "config" or UNKNOWN in sub:
            self.check_config(rest)
        if sub not in GIT_BUILTINS and UNKNOWN not in sub:
            env = {**os.environ, **st.exported, **temp}
            self.follow_alias(sub, rest, (cwd, opts, env), st, temp, depth)

    @staticmethod
    def check_commit(rest: list[str]) -> None:
        i = 0
        while i < len(rest):
            a = rest[i]
            i += 1
            if a == "--":
                break
            if a in COMMIT_VALUE_OPTS:
                i += 1
            elif is_no_verify(a):
                raise Denied("git commit --no-verify は拒否しました。git フックを飛ばさないでください")
            elif len(a) > 1 and a[0] == "-" and a[1] != "-":
                for j, c in enumerate(a[1:], 1):
                    if c == "n":
                        raise Denied("git commit -n（--no-verify）は拒否しました。git フックを飛ばさないでください")
                    if c in COMMIT_SHORT_VALUE:
                        if j == len(a) - 1 and c not in "Su":
                            i += 1  # 値は次の語
                        break

    @staticmethod
    def check_config(rest: list[str]) -> None:
        positional: list[str] = []
        read = write = False
        mentions = False
        i = 0
        while i < len(rest):
            a = rest[i]
            i += 1
            name = a.split("=", 1)[0]
            if a in CONFIG_VALUE_OPTS:
                i += 1
            elif name in CONFIG_READ_OPTS:
                read = True
                if "=" in a:
                    positional.append(a.split("=", 1)[1])
            elif a in ("--remove-section", "--rename-section"):
                if i < len(rest) and rest[i].lower() == "core":
                    mentions = write = True
                i += 1
            elif a.startswith("-"):
                pass
            else:
                positional.append(a)
        if positional and positional[0] in CONFIG_READ_SUBS:
            read = True
        mentions = mentions or any(names_hooks_path(p) or UNKNOWN in p for p in positional)
        if positional and positional[0] in ("remove-section", "rename-section") and len(positional) > 1:
            mentions = mentions or positional[1].lower() == "core"
        if not mentions:
            return
        # git config core.hooksPath のように、キーだけを書いたものは読み取り
        legacy_read = not write and len(positional) == 1 and not any(
            a.split("=", 1)[0] in ("--unset", "--unset-all", "--add", "--replace-all", "--edit", "-e") for a in rest)
        if read or legacy_read:
            return
        raise Denied("git config で core.hooksPath を設定・削除する操作は拒否しました。git フックを飛ばさないでください")

    @staticmethod
    def git_out(ctx: tuple, *args: str) -> str | None:
        cwd, opts, env = ctx
        p = subprocess.run(["git", "-C", str(cwd), *opts, *args], capture_output=True, text=True, env=env, timeout=5)
        return p.stdout.strip() if p.returncode == 0 else None

    def follow_alias(self, sub: str, rest: list[str], ctx: tuple, st: State, temp: dict, depth: int) -> None:
        cwd, opts, _ = ctx
        if cwd is None or not cwd.is_dir() or any(UNKNOWN in o for o in opts):
            return
        value = self.git_out(ctx, "config", "--get", f"alias.{sub}")
        if not value:
            return
        inner = st.copy()
        inner.cwd = cwd
        if value.startswith("!"):
            self.run_text(" ".join([value[1:], *rest]), self.with_temp(inner, temp), depth + 1)
            return
        parsed = Parser(value).parse()
        words = parsed[0].words if parsed and isinstance(parsed[0], Cmd) else []
        if depth + 1 > MAX_DEPTH:
            raise Denied("git のエイリアスが深すぎて判定できません")
        self.git([*opts, *words, *rest], inner, temp, depth + 1)


def check(payload: dict) -> str | None:
    """拒否する理由を返す。許可なら None。"""
    if payload.get("tool_name") != "Bash":
        return None
    command = (payload.get("tool_input") or {}).get("command")
    if not isinstance(command, str):
        return "Bash のコマンドを読めません"
    cwd = payload.get("cwd")
    start = Path(cwd) if isinstance(cwd, str) and os.path.isabs(cwd) else None
    try:
        if re.search("[\x01-\x03]", command):
            raise ValueError("制御文字を含みます")
        Guard().walk(Parser(command).parse(), State(start), 0)
    except Denied as e:
        return str(e)
    except Exception as e:
        # 解析できなくても、フックの回避に関係なさそうなコマンドまでは止めない
        if re.search(r"no-ver|hookspath|GIT_CONFIG|\bcommit\b", command, re.I):
            return f"コマンドを解析できないので拒否します: {e}"
    return None


def main() -> int:
    try:
        args = sys.argv[1:]
        while args:
            # --allow は以前の版との互換のために受け付け、無視する
            if args[0] != "--allow" or len(args) < 2:
                print("hub-commit-guard: usage: hub-commit-guard", file=sys.stderr)
                return 2
            args = args[2:]
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("入力が JSON のオブジェクトではありません")
        reason = check(payload)
    except Exception as e:
        print(f"hub-commit-guard: 判定に失敗したので拒否します: {e}", file=sys.stderr)
        return 2
    if reason:
        print(f"hub-commit-guard: {reason}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
