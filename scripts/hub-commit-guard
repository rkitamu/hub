#!/usr/bin/env python3
"""main / master への git commit と git push、force push、git commit --amend を拒否する PreToolUse フック（Bash 用）。

usage: hub-commit-guard [--allow <リポジトリ>]…

--allow は、作業文書や TODO のデータのように、ローカルでのみバージョン管理するリポジトリ。
git merge と git merge --continue は止めない（remote の無いリポジトリのローカルマージに使う）。
Bash のコマンドを実行せずに解析し、git -C・--git-dir・GIT_DIR=・cd・複合コマンド・サブシェル・
$(...)・bash -c・eval・env / sudo / xargs / find -exec・git のエイリアスを辿る。
`git switch -c x && git commit` のように && でつながった切り替えは、切り替え先のブランチで判定する。
コミット先や push 先を判定できないときは拒否する（exit 2）。

対象外: スクリプトファイルの中身、実行時に決まる文字列の組み立て、Bash 以外の経路。
誤操作の防止であり、セキュリティの境界ではない。
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

PROTECTED = {"main", "master"}
UNKNOWN = "\x03"
VAR = re.compile("\x01(\\w+)\x02")
MAX_DEPTH = 8
KEYWORDS = {"{", "}", "!", "then", "do", "else", "elif", "if", "while", "until", "time", "coproc", "done", "fi", "esac"}
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
# 引数の次の語を値として取る、ラッパーのオプション
WRAPPERS: dict[str, set[str]] = {
    "command": set(), "builtin": set(), "exec": {"-a"}, "nohup": set(), "setsid": set(),
    "sudo": {"-u", "-g", "-h", "-p", "-C", "-D", "-R", "-T", "-U"},
    "nice": {"-n"}, "ionice": {"-c", "-n", "-p"}, "stdbuf": {"-i", "-o", "-e"},
    "xargs": {"-I", "-n", "-P", "-L", "-d", "-E", "-s", "-a"},
    "timeout": {"-s", "-k"},
}
# git commit で次の語を値として取るオプション（--amend と見間違えないため）
COMMIT_VALUE_OPTS = {"-m", "-F", "-C", "-c", "-t", "--message", "--file", "--reuse-message", "--reedit-message", "--template",
                     "--author", "--date", "--fixup", "--squash", "--trailer", "--cleanup", "--pathspec-from-file"}
PUSH_VALUE_OPTS = {"--repo", "--exec", "--receive-pack", "--push-option"}
PUSH_FORCE_OPTS = ("--force", "--force-with-lease", "--force-if-includes")
PUSH_ALL_OPTS = ("--mirror", "--all", "--branches")
GIT_VALUE_OPTS = {"--git-dir", "--work-tree", "--namespace", "--config-env", "--super-prefix"}
# エイリアスを調べなくてよい、よく使うサブコマンド
GIT_BUILTINS = {"status", "add", "diff", "log", "show", "fetch", "pull", "push", "branch", "rev-parse", "remote", "stash",
                "restore", "reset", "merge", "rebase", "tag", "config", "init", "clone", "worktree", "ls-files",
                "symbolic-ref", "blame", "grep", "rm", "mv", "cherry-pick", "revert", "describe", "submodule"}


class Denied(Exception):
    pass


# ── シェルの字句解析（実行はしない） ─────────────────────────────


@dataclass
class Cmd:
    words: list[str] = field(default_factory=list)
    subs: list[list] = field(default_factory=list)
    heredocs: list[str] = field(default_factory=list)
    prev_op: str = ";"
    next_op: str | None = None


@dataclass
class Group:
    items: list
    prev_op: str = ";"
    next_op: str | None = None


class Parser:
    def __init__(self, s: str):
        self.s = s
        self.i = 0
        self.pending: list[tuple[Cmd, str, bool]] = []

    def peek(self, text: str) -> bool:
        return self.s.startswith(text, self.i)

    def parse(self, closer: str | None = None) -> list:
        s = self.s
        items: list = []
        cur = Cmd()
        word: str | None = None
        skip = False
        prev = ";"

        def flush_word() -> None:
            nonlocal word, skip
            if word is not None:
                if not skip:
                    cur.words.append(word)
                skip = False
                word = None

        def flush_cmd(op: str) -> None:
            nonlocal cur, prev
            flush_word()
            if cur.words or cur.subs or cur.heredocs:
                cur.prev_op, cur.next_op = prev, op
                items.append(cur)
                cur = Cmd()
            elif items and items[-1].next_op is None:
                items[-1].next_op = op
            prev = op

        while self.i < len(s):
            c = s[self.i]
            if c in " \t":
                flush_word()
                self.i += 1
            elif c == "\n":
                flush_cmd(";")
                self.i += 1
                self.read_heredocs()
            elif c == "#" and word is None:
                while self.i < len(s) and s[self.i] != "\n":
                    self.i += 1
            elif c == ";":
                flush_cmd(";")
                self.i += 2 if self.peek(";;") else 1
            elif c == "&" and self.s[self.i + 1:self.i + 2] == ">":
                flush_word()
                self.i += 3 if self.peek("&>>") else 2
                skip = True
            elif c == "&":
                op = "&&" if self.peek("&&") else "&"
                flush_cmd(op)
                self.i += len(op)
            elif c == "|":
                op = "||" if self.peek("||") else "|&" if self.peek("|&") else "|"
                flush_cmd(op)
                self.i += len(op)
            elif c in "<>":
                if word is not None and word.isdigit():
                    word = None
                flush_word()
                if self.peek("<(") or self.peek(">("):
                    self.i += 2
                    cur.subs.append(self.parse(")"))
                    word = UNKNOWN
                elif self.peek("<<<"):
                    self.i += 3
                    skip = True
                elif self.peek("<<"):
                    self.i += 2
                    strip = self.peek("-")
                    self.i += 1 if strip else 0
                    self.pending.append((cur, self.read_delim(), strip))
                else:
                    self.i += 1
                    while self.i < len(s) and s[self.i] in ">&|":
                        self.i += 1
                    skip = True
            elif c == "(":
                if word is not None and self.s[self.i + 1:self.i + 2] == ")":  # 関数定義 f()
                    word = None
                    cur = Cmd()
                    self.i += 2
                    continue
                flush_word()
                self.i += 1
                group = Group(self.parse(")"), prev_op=prev)
                items.append(group)
            elif c == ")":
                self.i += 1
                if closer == ")":
                    flush_cmd(";")
                    return items
                word = None  # case のパターン
                cur = Cmd()
            elif c == "'":
                end = s.find("'", self.i + 1)
                if end < 0:
                    raise ValueError("引用符が閉じていません")
                word = (word or "") + s[self.i + 1:end]
                self.i = end + 1
            elif c == '"':
                word = (word or "") + self.read_dquote(cur)
            elif c == "\\":
                if self.s[self.i + 1:self.i + 2] != "\n":
                    word = (word or "") + self.s[self.i + 1:self.i + 2]
                self.i += 2
            elif c == "`":
                word = (word or "") + self.read_backtick(cur)
            elif c == "$":
                word = (word or "") + self.read_dollar(cur)
            else:
                word = (word or "") + c
                self.i += 1
        if closer:
            raise ValueError("括弧が閉じていません")
        flush_cmd(";")
        return items

    def read_delim(self) -> str:
        s = self.s
        while self.i < len(s) and s[self.i] in " \t":
            self.i += 1
        out = ""
        while self.i < len(s) and s[self.i] not in " \t\n;&|<>()":
            c = s[self.i]
            if c in "'\"":
                end = s.find(c, self.i + 1)
                if end < 0:
                    raise ValueError("引用符が閉じていません")
                out += s[self.i + 1:end]
                self.i = end + 1
            elif c == "\\":
                out += s[self.i + 1:self.i + 2]
                self.i += 2
            else:
                out += c
                self.i += 1
        return out

    def read_heredocs(self) -> None:
        for cmd, delim, strip in self.pending:
            lines = []
            while self.i < len(self.s):
                end = self.s.find("\n", self.i)
                end = len(self.s) if end < 0 else end
                line = self.s[self.i:end]
                self.i = min(end + 1, len(self.s))
                if (line.lstrip("\t") if strip else line) == delim:
                    break
                lines.append(line)
            cmd.heredocs.append("\n".join(lines))
        self.pending = []

    def read_dquote(self, cur: Cmd) -> str:
        s = self.s
        self.i += 1
        out = ""
        while self.i < len(s):
            c = s[self.i]
            if c == '"':
                self.i += 1
                return out
            if c == "\\":
                nxt = s[self.i + 1:self.i + 2]
                if nxt == "\n":
                    pass
                elif nxt in ('$', '`', '"', "\\"):
                    out += nxt
                else:
                    out += c + nxt
                self.i += 2
            elif c == "$":
                out += self.read_dollar(cur)
            elif c == "`":
                out += self.read_backtick(cur)
            else:
                out += c
                self.i += 1
        raise ValueError("引用符が閉じていません")

    def read_backtick(self, cur: Cmd) -> str:
        s = self.s
        j = self.i + 1
        body = ""
        while j < len(s) and s[j] != "`":
            if s[j] == "\\" and j + 1 < len(s):
                body += s[j + 1]
                j += 2
            else:
                body += s[j]
                j += 1
        if j >= len(s):
            raise ValueError("バッククォートが閉じていません")
        self.i = j + 1
        cur.subs.append(Parser(body).parse())
        return UNKNOWN

    def read_dollar(self, cur: Cmd) -> str:
        s = self.s
        if self.peek("$(("):
            depth, j = 0, self.i + 1
            while j < len(s):
                depth += (s[j] == "(") - (s[j] == ")")
                j += 1
                if depth == 0:
                    break
            self.i = j
            return UNKNOWN
        if self.peek("$("):
            self.i += 2
            cur.subs.append(self.parse(")"))
            return UNKNOWN
        if self.peek("${"):
            end = s.find("}", self.i)
            if end < 0:
                raise ValueError("${ が閉じていません")
            name = s[self.i + 2:end]
            self.i = end + 1
            return f"\x01{name}\x02" if re.fullmatch(r"\w+", name) else UNKNOWN
        if self.peek("$'"):
            end = s.find("'", self.i + 2)
            if end < 0:
                raise ValueError("引用符が閉じていません")
            out = s[self.i + 2:end]
            self.i = end + 1
            return out
        m = re.compile(r"\$(\w+)").match(s, self.i)
        if m:
            self.i = m.end()
            return f"\x01{m.group(1)}\x02"
        if s[self.i + 1:self.i + 2] in ("?", "!", "#", "@", "*", "-"):
            self.i += 2
            return UNKNOWN
        self.i += 1
        return "$"


# ── 判定 ───────────────────────────────────────────────────────


@dataclass
class State:
    cwd: Path | None
    vars: dict[str, str] = field(default_factory=dict)
    exported: dict[str, str] = field(default_factory=dict)
    override: dict[str, str] = field(default_factory=dict)  # && の連なりの中で切り替えたブランチ

    def copy(self) -> "State":
        return State(self.cwd, dict(self.vars), dict(self.exported), dict(self.override))


class Guard:
    def __init__(self, allow: list[Path]):
        self.allow = {p.resolve() for p in allow}

    # ── 語の展開 ──

    def expand(self, word: str, st: State, temp: dict[str, str]) -> str:
        def repl(m: re.Match) -> str:
            name = m.group(1)
            for scope in (temp, st.exported, st.vars, os.environ):
                if name in scope:
                    return scope[name]
            return UNKNOWN
        out = VAR.sub(repl, word)
        if out == "~" or out.startswith("~/"):
            out = str(Path.home()) + out[1:]
        return out

    @staticmethod
    def chdir(base: Path | None, target: str) -> Path | None:
        if UNKNOWN in target or base is None and not target.startswith("/"):
            return None
        return Path(os.path.normpath(base / target if base else target))

    # ── 走査 ──

    def walk(self, items: list, st: State, depth: int) -> None:
        if depth > MAX_DEPTH:
            raise Denied("コマンドの入れ子が深すぎて判定できません")
        for item in items:
            if item.prev_op != "&&":
                st.override.clear()
            if isinstance(item, Group):
                self.walk(item.items, st.copy(), depth + 1)
                continue
            for sub in item.subs:
                self.walk(sub, st.copy(), depth + 1)
            # パイプやバックグラウンドの各段はサブシェルなので、cd などは後に残らない
            isolated = item.prev_op in ("|", "|&") or item.next_op in ("|", "|&", "&")
            self.run(list(item.words), st.copy() if isolated else st, item, {}, depth)

    def run_text(self, text: str, st: State, depth: int) -> None:
        self.walk(Parser(text).parse(), st.copy(), depth + 1)

    def run(self, words: list[str], st: State, item: Cmd, temp: dict[str, str], depth: int) -> None:
        if depth > MAX_DEPTH:
            raise Denied("コマンドの入れ子が深すぎて判定できません")
        while words and words[0] in KEYWORDS:
            words = words[1:]
        temp = dict(temp)
        while words and (m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", words[0], re.S)):
            temp[m.group(1)] = self.expand(m.group(2), st, temp)
            words = words[1:]
        if not words:
            st.vars.update(temp)
            return
        words = [self.expand(w, st, temp) for w in words]
        name = os.path.basename(words[0])
        args = words[1:]

        if UNKNOWN in words[0]:  # $GIT commit のように、実行時に決まるコマンド
            if "commit" in args or "push" in args:
                self.git(args, st, item, temp, depth)
            return
        if name == "git":
            self.git(args, st, item, temp, depth)
        elif name in ("cd", "pushd"):
            rest = [a for a in args if a not in ("-L", "-P", "-e", "--")]
            target = rest[0] if rest else str(Path.home())
            if target == "-":
                st.cwd = None
            else:
                new = self.chdir(st.cwd, target)
                # 存在しない場所への cd は失敗するので、今の場所のまま
                if new is None or new.is_dir():
                    st.cwd = new
        elif name == "popd":
            st.cwd = None
        elif name == "export":
            for a in args:
                if m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", a, re.S):
                    st.exported[m.group(1)] = m.group(2)
                elif a in st.vars:
                    st.exported[a] = st.vars[a]
        elif name == "unset":
            for a in args:
                st.vars.pop(a, None)
                st.exported.pop(a, None)
        elif name == "eval":
            self.run_text(" ".join(args), self.with_temp(st, temp), depth)
        elif name == "env":
            self.run_env(args, st, item, temp, depth)
        elif name == "find":
            for i, a in enumerate(args):
                if a in ("-exec", "-execdir", "-ok", "-okdir"):
                    rest = args[i + 1:]
                    end = next((j for j, x in enumerate(rest) if x in (";", "+")), len(rest))
                    self.run(rest[:end], st.copy(), item, temp, depth + 1)
        elif name in SHELLS:
            self.run_shell(args, st, item, temp, depth)
        elif name in WRAPPERS:
            self.run_wrapper(name, args, st, item, temp, depth)

    @staticmethod
    def with_temp(st: State, temp: dict[str, str]) -> State:
        out = st.copy()
        out.exported.update(temp)
        return out

    def run_env(self, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        st = st.copy()
        temp = dict(temp)
        i = 0
        while i < len(args):
            a = args[i]
            if a in ("-u", "--unset"):
                temp.pop(args[i + 1] if i + 1 < len(args) else "", None)
                i += 2
            elif a in ("-C", "--chdir"):
                st.cwd = self.chdir(st.cwd, args[i + 1]) if i + 1 < len(args) else None
                i += 2
            elif a.startswith("--chdir="):
                st.cwd = self.chdir(st.cwd, a.split("=", 1)[1])
                i += 1
            elif a in ("-S", "--split-string"):
                rest = " ".join(args[i + 1:])
                self.run_text(rest, self.with_temp(st, temp), depth)
                return
            elif a.startswith("-"):
                i += 1
            elif m := re.fullmatch(r"([A-Za-z_]\w*)=(.*)", a, re.S):
                temp[m.group(1)] = m.group(2)
                i += 1
            else:
                break
        self.run(args[i:], st, item, temp, depth + 1)

    def run_shell(self, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        for i, a in enumerate(args):
            if a.startswith("-") and not a.startswith("--") and "c" in a:
                if i + 1 < len(args):
                    if UNKNOWN in args[i + 1] and ("commit" in args[i + 1] or "push" in args[i + 1]):
                        raise Denied("bash -c の中身を判定できません")
                    self.run_text(args[i + 1], self.with_temp(st, temp), depth)
                return
            if not a.startswith("-"):
                return  # スクリプトファイルは読まない
        for body in item.heredocs:
            self.run_text(body, self.with_temp(st, temp), depth)

    def run_wrapper(self, name: str, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        if name == "command" and any(a in ("-v", "-V") for a in args):
            return
        takes_value = WRAPPERS[name]
        i = 0
        while i < len(args) and args[i].startswith("-"):
            if args[i] == "--":
                i += 1
                break
            i += 2 if args[i] in takes_value else 1
        if name == "timeout":
            i += 1  # 時間の引数
        elif name == "sudo":
            while i < len(args) and re.fullmatch(r"[A-Za-z_]\w*=.*", args[i], re.S):
                i += 1
        self.run(args[i:], st, item, temp, depth + 1)

    # ── git ──

    def git(self, args: list[str], st: State, item: Cmd, temp: dict, depth: int) -> None:
        cwd = st.cwd
        opts: list[str] = []
        i = 0
        while i < len(args):
            a = args[i]
            if a == "-C":
                cwd = self.chdir(cwd, args[i + 1]) if i + 1 < len(args) else None
                i += 2
            elif a == "-c":
                opts += args[i:i + 2]
                i += 2
            elif a in GIT_VALUE_OPTS:
                opts += self.path_opt(a, args[i + 1] if i + 1 < len(args) else UNKNOWN, cwd)
                i += 2
            elif a.startswith("--") and "=" in a and a.split("=", 1)[0] in GIT_VALUE_OPTS:
                key, value = a.split("=", 1)
                opts += self.path_opt(key, value, cwd)
                i += 1
            elif a.startswith("-") and UNKNOWN not in a:
                i += 1
            else:
                break
        if i >= len(args):
            return
        sub, rest = args[i], args[i + 1:]
        env = {**os.environ, **st.exported, **temp}
        ctx = (cwd, opts, env)

        if UNKNOWN in sub:
            if "push" in rest:
                raise Denied(f"git {sub} の push 先を判定できません")
            if "commit" in rest or not rest:
                self.check_commit(ctx, st, f"git {sub}", self.has_amend(rest))
            return
        if sub == "commit":
            if "--dry-run" not in rest and "-h" not in rest and "--help" not in rest:
                self.check_commit(ctx, st, "git commit", self.has_amend(rest))
        elif sub == "push":
            self.check_push(rest, ctx, st)
        elif sub in ("switch", "checkout"):
            self.track_switch(sub, rest, ctx, st, item)
        elif sub not in GIT_BUILTINS:
            self.follow_alias(sub, rest, ctx, st, item, temp, depth)

    @staticmethod
    def path_opt(key: str, value: str, cwd: Path | None) -> list[str]:
        if key in ("--git-dir", "--work-tree"):
            if UNKNOWN in value:
                return [f"{key}={UNKNOWN}"]
            if cwd is not None:
                value = os.path.normpath(cwd / value)
        return [f"{key}={value}"]

    @staticmethod
    def git_out(ctx: tuple, *args: str) -> str | None:
        cwd, opts, env = ctx
        p = subprocess.run(["git", "-C", str(cwd), *opts, *args], capture_output=True, text=True, env=env, timeout=5)
        return p.stdout.strip() if p.returncode == 0 else None

    def follow_alias(self, sub: str, rest: list[str], ctx: tuple, st: State, item: Cmd, temp: dict, depth: int) -> None:
        cwd, opts, _ = ctx
        if cwd is None or not cwd.is_dir() or any(UNKNOWN in o for o in opts):
            return
        value = self.git_out(ctx, "config", "--get", f"alias.{sub}")
        if not value:
            return
        inner = st.copy()
        inner.cwd = cwd
        if value.startswith("!"):
            self.run_text(value[1:], self.with_temp(inner, temp), depth + 1)
            return
        parsed = Parser(value).parse()
        words = parsed[0].words if parsed and isinstance(parsed[0], Cmd) else []
        if depth + 1 > MAX_DEPTH:
            raise Denied("git のエイリアスが深すぎて判定できません")
        self.git([*opts, *words, *rest], inner, item, temp, depth + 1)

    @staticmethod
    def has_amend(rest: list[str]) -> bool:
        amend = False
        i = 0
        while i < len(rest):
            a = rest[i]
            i += 1
            if a == "--":
                break
            if a in COMMIT_VALUE_OPTS:
                i += 1
            elif len(a) >= 4 and "--amend".startswith(a):  # git は一意な省略形を受け付ける
                amend = True
            elif a == "--no-amend":
                amend = False
        return amend

    def check_commit(self, ctx: tuple, st: State, what: str, amend: bool = False) -> None:
        cwd, opts, _ = ctx
        if cwd is None or any(UNKNOWN in o for o in opts):
            raise Denied(f"{what} のコミット先を判定できません。cd や -C には実際のパスを書いてください")
        if not cwd.is_dir():
            return  # git 自身が失敗する
        gitdir = self.git_out(ctx, "rev-parse", "--absolute-git-dir")
        if gitdir is None:
            return  # リポジトリの外
        top = self.git_out(ctx, "rev-parse", "--show-toplevel")
        if top and Path(top).resolve() in self.allow:
            return
        if amend:
            raise Denied(f"git commit --amend は拒否しました（{top or gitdir}）。新しいコミットを追加してください")
        branch = st.override.get(gitdir)
        if branch is None:
            branch = self.git_out(ctx, "symbolic-ref", "-q", "--short", "HEAD") or ""
        if branch in PROTECTED:
            raise Denied(f"{branch} への git commit は拒否しました（{top or gitdir}）。"
                         "git switch -c <作業ブランチ> で作業ブランチを切ってからコミットしてください")

    def check_push(self, rest: list[str], ctx: tuple, st: State) -> None:
        if "-h" in rest or "--help" in rest:
            return
        positional: list[str] = []
        repo: str | None = None
        dry = tags = only_args = False
        bad: str | None = None
        i = 0
        while i < len(rest):
            a = rest[i]
            i += 1
            if only_args or a == "-" or not a.startswith("-"):
                positional.append(a)
            elif a == "--":
                only_args = True
            elif UNKNOWN in a:
                raise Denied("git push のオプションを判定できません")
            elif a.startswith("--"):
                name = a.split("=", 1)[0]
                if name in PUSH_VALUE_OPTS:
                    value = a.split("=", 1)[1] if "=" in a else (rest[i] if i < len(rest) else "")
                    i += 0 if "=" in a else 1
                    if name == "--repo":
                        repo = value
                elif len(name) >= 5 and any(f.startswith(name) for f in PUSH_FORCE_OPTS):
                    bad = "force push"
                elif len(name) >= 4 and any(f.startswith(name) for f in PUSH_ALL_OPTS):
                    bad = f"git push {name}"
                elif name == "--dry-run":
                    dry = True
                elif name == "--no-dry-run":
                    dry = False
                elif name == "--tags":
                    tags = True
            else:
                for j, c in enumerate(a[1:], 1):
                    if c == "f":
                        bad = "force push"
                    elif c == "n":
                        dry = True
                    elif c == "o":  # 値を取る。-ofoo は残りが値
                        i += 1 if j == len(a) - 1 else 0
                        break
        if dry:
            return
        cwd, opts, _ = ctx
        if cwd is None or any(UNKNOWN in o for o in opts):
            raise Denied("git push の対象を判定できません。cd や -C には実際のパスを書いてください")
        if not cwd.is_dir():
            return  # git 自身が失敗する
        gitdir = self.git_out(ctx, "rev-parse", "--absolute-git-dir")
        if gitdir is None:
            return  # リポジトリの外
        top = self.git_out(ctx, "rev-parse", "--show-toplevel")
        if top and Path(top).resolve() in self.allow:
            return
        where = top or gitdir
        if bad:
            raise Denied(f"{bad} は拒否しました（{where}）")
        if any(UNKNOWN in a for a in positional) or (repo and UNKNOWN in repo):
            raise Denied("git push の宛先を判定できません")
        branch = st.override.get(gitdir)
        if branch is None:
            branch = self.git_out(ctx, "symbolic-ref", "-q", "--short", "HEAD") or ""

        def config(key: str) -> str | None:
            return self.git_out(ctx, "config", "--get", key) or None

        remote = (positional[0] if positional else repo) or (branch and config(f"branch.{branch}.pushRemote")) \
            or config("remote.pushDefault") or (branch and config(f"branch.{branch}.remote")) or "origin"
        if (config(f"remote.{remote}.mirror") or "").lower() in ("true", "yes", "on", "1"):
            raise Denied(f"mirror の remote への git push は拒否しました（{where}）")
        configured = (self.git_out(ctx, "config", "--get-all", f"remote.{remote}.push") or "").split()
        refspecs = positional[1:]
        for spec in refspecs:
            self.check_refspec(spec, branch, where)
        if refspecs:
            # NOTE: コロンの無い refspec は、remote.<name>.push で別の宛先へ写されることがある。
            if any(":" not in s for s in refspecs):
                for spec in configured:
                    self.check_refspec(spec, branch, where)
            return
        if tags:
            return
        if configured:
            for spec in configured:
                self.check_refspec(spec, branch, where)
            return
        mode = config("push.default") or "simple"
        if mode == "nothing":
            return
        if mode == "matching":
            raise Denied(f"push.default=matching の git push は main / master を含むので拒否しました（{where}）")
        if branch in PROTECTED:
            raise Denied(f"{branch} への git push は拒否しました（{where}）")
        if mode in ("upstream", "tracking") and branch:
            self.check_refspec(f"{branch}:{config(f'branch.{branch}.merge') or branch}", branch, where)

    @staticmethod
    def check_refspec(spec: str, branch: str, where: str) -> None:
        if spec.startswith("+"):
            raise Denied(f"force push（{spec}）は拒否しました（{where}）")
        src, sep, dst = spec.partition(":")
        if sep and not src and not dst:
            raise Denied(f"git push の : は main / master を含むので拒否しました（{where}）")
        dst = dst or src
        if dst in ("HEAD", "@"):
            dst = branch
        if "*" in dst:
            raise Denied(f"ワイルドカードの git push（{spec}）は拒否しました（{where}）")
        name = dst.removeprefix("refs/heads/").removeprefix("heads/") if dst.startswith(("refs/heads/", "heads/")) else dst
        if name in PROTECTED:
            raise Denied(f"{name} への git push は拒否しました（{where}）")

    def track_switch(self, sub: str, rest: list[str], ctx: tuple, st: State, item: Cmd) -> None:
        cwd, opts, _ = ctx
        if cwd is None or not cwd.is_dir() or any(UNKNOWN in o for o in opts):
            return
        # 成功したときだけ次へ進む && のときに限り、切り替えを信じる
        if item.next_op != "&&" or item.prev_op in ("||", "|", "|&", "&"):
            return
        gitdir = self.git_out(ctx, "rev-parse", "--absolute-git-dir")
        if gitdir is None:
            return
        target = self.switch_target(sub, rest, ctx)
        if target is not None:
            st.override[gitdir] = target

    def switch_target(self, sub: str, rest: list[str], ctx: tuple) -> str | None:
        """切り替え先のブランチ名を返す。detached は ""、切り替わらない・分からないなら None。"""
        creators = {"-c", "-C", "--create", "--force-create", "--orphan"} if sub == "switch" else {"-b", "-B", "--orphan"}
        positional: list[str] = []
        for i, a in enumerate(rest):
            if a == "--":
                if sub == "checkout":
                    return None  # ファイルの復元
                break
            if a in creators:
                return rest[i + 1] if i + 1 < len(rest) else None
            if a.startswith("--") and "=" in a and a.split("=", 1)[0] in creators:
                return a.split("=", 1)[1]
            if a == "--detach" or (sub == "switch" and a == "-d"):
                return ""
            if a == "-" or not a.startswith("-"):
                positional.append(a)
        if not positional:
            return None
        target = positional[0]
        if UNKNOWN in target:
            return None
        if target == "-":
            return self.git_out(ctx, "rev-parse", "--abbrev-ref", "@{-1}")
        if self.git_out(ctx, "rev-parse", "--verify", "-q", f"refs/heads/{target}") is not None:
            return target
        return target if sub == "switch" else None


def check(payload: dict, allow: list[Path]) -> str | None:
    """拒否する理由を返す。許可なら None。"""
    if payload.get("tool_name") != "Bash":
        return None
    command = (payload.get("tool_input") or {}).get("command")
    if not isinstance(command, str):
        return "Bash のコマンドを読めません"
    cwd = payload.get("cwd")
    start = Path(cwd) if isinstance(cwd, str) and os.path.isabs(cwd) else None
    try:
        if re.search("[\x01-\x03]", command):
            raise ValueError("制御文字を含みます")
        Guard(allow).walk(Parser(command).parse(), State(start), 0)
    except Denied as e:
        return str(e)
    except Exception as e:
        # 解析できなくても、git に関係なさそうなコマンドまでは止めない
        if "git" in command or "commit" in command or "push" in command:
            return f"コマンドを解析できないので拒否します: {e}"
    return None


def main() -> int:
    try:
        args = sys.argv[1:]
        allow: list[Path] = []
        while args:
            if args[0] != "--allow" or len(args) < 2 or not os.path.isabs(args[1]):
                print("hub-commit-guard: usage: hub-commit-guard [--allow <絶対パス>]…", file=sys.stderr)
                return 2
            allow.append(Path(args[1]))
            args = args[2:]
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("入力が JSON のオブジェクトではありません")
        reason = check(payload, allow)
    except Exception as e:
        print(f"hub-commit-guard: 判定に失敗したので拒否します: {e}", file=sys.stderr)
        return 2
    if reason:
        print(f"hub-commit-guard: {reason}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
