#!/usr/bin/env python3
"""git フックを飛ばす操作を拒否する PreToolUse フック（Bash 用）。

usage: hub-commit-guard [--allow <パス>]…   （--allow は互換のために受け付け、無視する）

Bash のコマンド文字列全体を調べ、次のものを含めば拒否する（exit 2）。
- --no-verify
- git commit の -n（-an のような束ねを含む）
- core.hooksPath（-c・--config-env・GIT_CONFIG_*・git config による指定）。読むだけの git config は許可する

文字列の検査なので、コミットメッセージ中の文字列なども拒否する。誤操作の防止であり、セキュリティの境界ではない。
main / master の保護は、各リポジトリの git フックが受け持つ。
"""

import json
import re
import sys

CHECKS = [
    (re.compile(r"--no-verif"), "--no-verify"),
    (re.compile(r"\bcommit\b[^;&|\n]*\s-[A-Za-z]*n"), "git commit -n"),
    (re.compile(r"hookspath", re.I), "core.hooksPath の指定"),
]
# 読むだけの git config core.hooksPath
READ = re.compile(r"\bgit\s+config\s+(?:--get(?:-all)?\s+|get\s+)?core\.hookspath\s*(?=$|[;&|\n)])", re.I)


def check(payload: dict) -> str | None:
    """拒否する理由を返す。許可なら None。"""
    if payload.get("tool_name") != "Bash":
        return None
    command = (payload.get("tool_input") or {}).get("command")
    if not isinstance(command, str):
        return "Bash のコマンドを読めません"
    command = READ.sub("", command)
    for pattern, what in CHECKS:
        if pattern.search(command):
            return f"{what} は git フックを飛ばすので拒否しました"
    return None


def main() -> int:
    args = sys.argv[1:]
    while args:
        if args[0] != "--allow" or len(args) < 2:
            print("hub-commit-guard: usage: hub-commit-guard", file=sys.stderr)
            return 2
        args = args[2:]
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("入力が JSON のオブジェクトではありません")
        reason = check(payload)
    except Exception as e:
        reason = f"判定に失敗したので拒否します: {e}"
    if reason:
        print(f"hub-commit-guard: {reason}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
